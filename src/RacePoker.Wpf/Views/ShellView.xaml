<UserControl x:Class="RacePoker.Wpf.Views.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:RacePoker.Wpf.Controls" FontFamily="Segoe UI">
    <Grid Background="{StaticResource ArcadeInk}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="740" Margin="28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="166" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#72E6C2" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0">
                            <TextBlock Text="♠" FontSize="25" Foreground="#08151F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="RACE POKER" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ArcadeCream}" VerticalAlignment="Center" />
                        <Border BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ARCADE EDITION" Style="{StaticResource ArcadeCaption}" FontSize="10" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="How to play" Command="{Binding OpenHowToPlayCommand}" Style="{StaticResource ArcadeButton}" Margin="0,0,8,0" />
                        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ArcadeButton}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Margin="0,4,160,0">
                                <TextBlock Text="A GOOD HAND GOES A LONG WAY" Foreground="{StaticResource ArcadeMint}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14" />
                                <TextBlock Text="Play your cards.&#xA;Take the lead." Foreground="{StaticResource ArcadeCream}" FontSize="46" FontWeight="Bold" LineHeight="49" LineStackingStrategy="BlockLineHeight">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="LogoGlow" Color="#72E6C2" ShadowDepth="0" BlurRadius="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            <Grid Width="150" Height="145" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,6,0">
                                <Border Width="70" Height="100" Background="#F8F5EA" CornerRadius="5" RenderTransformOrigin="0.5,1" Margin="-35,0,0,0">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="CardRotate1" Angle="-15" />
                                    </Border.RenderTransform>
                                    <Image Source="/RacePoker.Wpf;component/Assets/PokerCards/jack_of_spades.png" Margin="3" />
                                </Border>
                                <Border Width="70" Height="100" Background="#F8F5EA" CornerRadius="5" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="CardRotate2" Angle="0" />
                                    </Border.RenderTransform>
                                    <Image Source="/RacePoker.Wpf;component/Assets/PokerCards/queen_of_hearts.png" Margin="3" />
                                </Border>
                                <Border Width="70" Height="100" Background="#F8F5EA" CornerRadius="5" RenderTransformOrigin="0.5,1" Margin="35,0,0,0">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="CardRotate3" Angle="15" />
                                    </Border.RenderTransform>
                                    <Image Source="/RacePoker.Wpf;component/Assets/PokerCards/king_of_diamonds.png" Margin="3" />
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Build a poker hand, send your horse down the track, and race&#xA;your friends to the finish. One screen. Up to four players." Foreground="{StaticResource ArcadeMuted}" FontSize="15" LineHeight="23" Margin="0,16,0,20" />
                        <controls:RaceTrack Grid.Row="2" IsDemo="True" FinishDistance="{Binding FinishDistance}" UseSymbol="{Binding UseSymbolIcon}" MinHeight="180" />
                    </Grid>
                    <Border Grid.Column="1" Background="{StaticResource ArcadePanel}" BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" CornerRadius="12" Padding="22,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="HighScoresHeader" Text="THE WINNER’S CIRCLE" Foreground="{StaticResource ArcadeGold}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="♜" FontSize="20" Foreground="{StaticResource ArcadeGold}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ComboBox ItemsSource="{Binding LeaderboardChoices}" SelectedItem="{Binding SelectedLeaderboard}" DisplayMemberPath="Label" FontSize="11" Padding="4" Margin="0,0,0,8" ToolTip="{Binding SelectedLeaderboard.Label}" AutomationProperties.Name="Leaderboard rules"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="77" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource ArcadeCaption}" />
                                <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource ArcadeCaption}" />
                                <TextBlock Grid.Column="2" Text="POINTS" Style="{StaticResource ArcadeCaption}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource ArcadeCaption}" HorizontalAlignment="Right" />
                            </Grid>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding HighScores}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#24404D" BorderThickness="0,0,0,1" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="77" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOne}}" Foreground="{StaticResource ArcadeMuted}" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="{Binding Initials}" Foreground="{StaticResource ArcadeCream}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=N0}" Foreground="{StaticResource ArcadeMint}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Date, StringFormat=MM/dd/yy}" Foreground="{StaticResource ArcadeMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighScores.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Your name belongs here." Foreground="{StaticResource ArcadeCream}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Finish a race to set the first record." Foreground="{StaticResource ArcadeMuted}" FontSize="13" Margin="0,8,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding StorageNotice}" ToolTip="{Binding StorageNotice}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ArcadeMuted}" FontSize="11" Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#102633" BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" CornerRadius="12" Padding="22,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="CHOOSE YOUR FIELD" Foreground="{StaticResource ArcadeCream}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Select players to start a race" Style="{StaticResource ArcadeCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="-4,14,-4,0">
                            <Button Command="{Binding PlayerJoinCommand}" CommandParameter="0" Style="{StaticResource ArcadePrimaryButton}" Margin="4,0" AutomationProperties.Name="Start one player race">
                                <StackPanel>
                                    <TextBlock Text="1 PLAYER" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Chase your personal best" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayerJoinCommand}" CommandParameter="1" Style="{StaticResource ArcadeButton}" Margin="4,0" AutomationProperties.Name="Start two player race">
                                <StackPanel>
                                    <TextBlock Text="2 PLAYERS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="A head-to-head race" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayerJoinCommand}" CommandParameter="2" Style="{StaticResource ArcadeButton}" Margin="4,0" AutomationProperties.Name="Start three player race">
                                <StackPanel>
                                    <TextBlock Text="3 PLAYERS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Raise the competition" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayerJoinCommand}" CommandParameter="3" Style="{StaticResource ArcadeButton}" Margin="4,0" AutomationProperties.Name="Start four player race">
                                <StackPanel>
                                    <TextBlock Text="4 PLAYERS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bring the whole table" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="2,10,2,0">
                    <TextBlock Text="{Binding RaceRulesDisplay}" Style="{StaticResource ArcadeCaption}" FontSize="11" />
                    <TextBlock Text="KEYBOARD: 1–4 to start  ·  F11 fullscreen" Style="{StaticResource ArcadeCaption}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>