<UserControl x:Class="RacePoker.Wpf.Views.RacePokerGameView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:RacePoker.Wpf.Controls" FontFamily="Segoe UI">
    <Grid Background="{StaticResource ArcadeInk}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="740" Margin="24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="214" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="112" />
                    <RowDefinition Height="164" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="♠" Foreground="{StaticResource ArcadeMint}" FontSize="26" Margin="0,0,10,0" />
                        <TextBlock Text="RACE POKER" Foreground="{StaticResource ArcadeCream}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ArcadePanel}" CornerRadius="5" Padding="10,5" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoundDisplay}" Foreground="{StaticResource ArcadeGold}" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding RaceRulesDisplay}" Style="{StaticResource ArcadeCaption}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="?" ToolTip="How to play" AutomationProperties.Name="How to play" Style="{StaticResource ArcadeButton}" Command="{Binding OpenHowToPlayCommand}" Margin="0,0,8,0" Padding="15,8" />
                        <Button Content="Settings" Style="{StaticResource ArcadeButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" Padding="12,8" />
                        <Button Content="Menu" Style="{StaticResource ArcadeButton}" Command="{Binding ExitGameCommand}" Padding="12,8" />
                    </StackPanel>
                </Grid>
                <controls:RaceTrack Grid.Row="1" Seats="{Binding SeatViewModels}" FinishDistance="{Binding FinishDistance}" UseSymbol="{Binding UseSymbolIcon}" Margin="0,4,0,8" />
                <Border Grid.Row="2" BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" Background="{StaticResource ArcadePanel}" CornerRadius="8" Padding="16,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POINT" Foreground="{StaticResource ArcadeGold}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="CHART" Foreground="{StaticResource ArcadeGold}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding PointChartEntries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource ArcadeMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ArcadeCream}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Background="#14333C" CornerRadius="8" Padding="16,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="154" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveSeat.SeatLabel}" Foreground="{Binding ActiveSeat.SeatColorBrush}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding HandProgressDisplay}" Style="{StaticResource ArcadeCaption}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TurnInstruction}" Foreground="{StaticResource ArcadeCream}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HandResultDisplay}" Foreground="{StaticResource ArcadeGold}" FontSize="13" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseHandResultLights}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UseHandResultMarquee}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#F4CF75" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountdownDisplay}" Foreground="{StaticResource ArcadeCream}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,6" />
                            <Border Height="5" Background="#08151F" CornerRadius="2">
                                <Border Background="{StaticResource ArcadeMint}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding TimerRemainingFraction}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="4" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOUR HAND" Foreground="{StaticResource ArcadeCream}" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Five picks. Make them count." Style="{StaticResource ArcadeCaption}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveSeat.Cards}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="66" Height="92" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                                    <Border Background="#F8F5EA" CornerRadius="5" Padding="3" Visibility="{Binding Card, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Card, Converter={StaticResource CardToImage}}" Stretch="Uniform" />
                                    </Border>
                                    <Border Background="#102633" CornerRadius="5" BorderBrush="#345261" BorderThickness="1" Visibility="{Binding Card, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <TextBlock Text="♠" Foreground="#385663" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="HAND POINTS" Style="{StaticResource ArcadeCaption}" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HandPointsDisplay}" Foreground="{StaticResource ArcadeGold}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="Awarded from the point chart" Style="{StaticResource ArcadeCaption}" FontSize="11" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="5" Background="{StaticResource ArcadePanel}" BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" CornerRadius="10" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PICK A CARD" Foreground="{StaticResource ArcadeMint}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectionHint}" Foreground="{StaticResource ArcadeMuted}" FontSize="13" TextWrapping="Wrap" Width="206" Margin="0,6,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveSeat.SelectionCards}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowSelectionRow, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,0">
                                        <Button Style="{StaticResource PickCardButton}" Width="90" Height="120" Command="{Binding ToggleHoldCommand}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding PickLabel}" AutomationProperties.Name="{Binding PickLabel}">
                                            <Image Source="{Binding Card, Converter={StaticResource CardToImage}}" Stretch="Uniform" />
                                        </Button>
                                        <TextBlock Text="{Binding KeyLabel}" Foreground="{StaticResource ArcadeMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowSelectionRow, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding ActiveSeat.HandName}" Foreground="{StaticResource ArcadeGold}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveSeat.RoundPoints, StringFormat={}{0:N0} points this round}" Foreground="{StaticResource ArcadeCream}" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,10" />
                            <Button Style="{StaticResource ArcadePrimaryButton}" Content="Next round →" Command="{Binding ActiveSeat.ContinueCommand}" Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVisibility}}" Padding="20,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PhaseDisplay}" Foreground="{StaticResource ArcadeMint}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ActiveSeat.TotalScore, StringFormat=N0}" Foreground="{StaticResource ArcadeCream}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0" />
                            <TextBlock Text="total points" Style="{StaticResource ArcadeCaption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="6" Margin="0,13,0,0">
                    <TextBlock Text="{Binding LeaderDisplay}" Foreground="{StaticResource ArcadeGold}" FontSize="12" />
                    <TextBlock Text="1–5 / F1–F5 pick  ·  Enter continue  ·  F11 fullscreen  ·  Esc menu" Style="{StaticResource ArcadeCaption}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.RowSpan="7" Background="#EA08151F" CornerRadius="10" Visibility="{Binding Phase, Converter={StaticResource PhaseToVisibility}, ConverterParameter=GameOver}">
                    <Border Background="{StaticResource ArcadePanel}" BorderBrush="{StaticResource ArcadeLine}" BorderThickness="1" CornerRadius="16" Padding="40,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="520">
                        <StackPanel>
                            <TextBlock Text="THE FINISH LINE" Foreground="{StaticResource ArcadeMint}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WinnerDisplay}" Foreground="{StaticResource ArcadeGold}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,12" />
                            <TextBlock Text="{Binding FinalStandings}" Foreground="{StaticResource ArcadeCream}" FontSize="17" LineHeight="28" HorizontalAlignment="Center" />
                            <TextBlock Text="Set your initials for the winner’s circle" Foreground="{StaticResource ArcadeMuted}" FontSize="13" Margin="0,18,0,4" HorizontalAlignment="Center" Visibility="{Binding HasInitialsEntries, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding InitialsEntries}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding PlayerLabel}" Foreground="{StaticResource ArcadeCream}" Width="95" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Initials, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" CharacterCasing="Upper" FontSize="18" Width="70" TextAlignment="Center" Background="#08151F" Foreground="{StaticResource ArcadeMint}" BorderBrush="{StaticResource ArcadeLine}" Padding="6" AutomationProperties.Name="{Binding PlayerLabel}" />
                                            <TextBlock Text="{Binding Score, StringFormat=N0}" Foreground="{StaticResource ArcadeGold}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Save scores &amp; return to menu" Style="{StaticResource ArcadePrimaryButton}" Command="{Binding ExitGameCommand}" Margin="0,22,0,0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>