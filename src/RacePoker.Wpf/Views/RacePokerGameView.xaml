<UserControl x:Class="RacePoker.Wpf.Views.RacePokerGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1280">

    <!-- ══════════════════════════════════════════════════════════
         RACE POKER IN-GAME VIEW — Megatouch Cabinet Layout
         Vertical stack: Track → Markers → Point Chart → Result → Cards
         ══════════════════════════════════════════════════════════ -->
    <Grid Background="#080810">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════
             ROW 0 — TOP BAR
             Left: progress bar + HI-SCORE
             Right: ? X buttons + player score boxes
             ════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0c0c1a" BorderBrush="#1a1a33" BorderThickness="0,0,0,1">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Phase display -->
                <TextBlock Grid.Column="0" Text="{Binding PhaseDisplay}"
                           Foreground="#667799" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Center: Timer countdown bar -->
                <Border Grid.Column="1" Height="28" CornerRadius="2" Background="Black"
                        BorderBrush="#DDC800" BorderThickness="2"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="400">
                    <Grid>
                        <Border CornerRadius="1" HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding TimerProgress}"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#DD2222" Offset="0"/>
                                    <GradientStop Color="#DDAA00" Offset="0.4"/>
                                    <GradientStop Color="#44DD44" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <!-- Score boxes -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,16,0">
                    <Border CornerRadius="4" Margin="2" Background="#0a0a18"
                            BorderBrush="#FF4444" BorderThickness="2" MinWidth="80"
                            Visibility="{Binding SeatViewModels[0].IsJoined, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="6,2">
                            <TextBlock Text="P1 Score" Foreground="#FF4444" FontSize="9"
                                       FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SeatViewModels[0].TotalScore, StringFormat=N0}"
                                       Foreground="#00FF88" FontSize="16" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Margin="2" Background="#0a0a18"
                            BorderBrush="#4488FF" BorderThickness="2" MinWidth="80"
                            Visibility="{Binding SeatViewModels[1].IsJoined, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="6,2">
                            <TextBlock Text="P2 Score" Foreground="#4488FF" FontSize="9"
                                       FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SeatViewModels[1].TotalScore, StringFormat=N0}"
                                       Foreground="#00FF88" FontSize="16" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Margin="2" Background="#0a0a18"
                            BorderBrush="#44DD44" BorderThickness="2" MinWidth="80"
                            Visibility="{Binding SeatViewModels[2].IsJoined, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="6,2">
                            <TextBlock Text="P3 Score" Foreground="#44DD44" FontSize="9"
                                       FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SeatViewModels[2].TotalScore, StringFormat=N0}"
                                       Foreground="#00FF88" FontSize="16" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Margin="2" Background="#0a0a18"
                            BorderBrush="#FFDD44" BorderThickness="2" MinWidth="80"
                            Visibility="{Binding SeatViewModels[3].IsJoined, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="6,2">
                            <TextBlock Text="P4 Score" Foreground="#FFDD44" FontSize="9"
                                       FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SeatViewModels[3].TotalScore, StringFormat=N0}"
                                       Foreground="#00FF88" FontSize="16" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Settings + X buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HelpBtn}"
                            Command="{Binding OpenSettingsCommand}" Margin="0,0,4,0">
                        <Image Source="/Assets/gear.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}" Content="X"
                            Command="{Binding ExitGameCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════
             ROW 1 — RACE TRACK (full width, compact)
             4 lanes always visible, score markers at bottom
             ════════════════════════════════════════════════ -->
        <Border Grid.Row="1" CornerRadius="4,4,0,0" BorderBrush="#446644" BorderThickness="2,2,2,0"
                Margin="4,4,4,0" Background="#1a5a1a">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Lane backgrounds (alternating green stripes) — collapse when not joined -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#2a7a2a" Height="52"
                        Visibility="{Binding SeatViewModels[0].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#237023" Height="52"
                        Visibility="{Binding SeatViewModels[1].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#2a7a2a" Height="52"
                        Visibility="{Binding SeatViewModels[2].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="#237023" Height="52"
                        Visibility="{Binding SeatViewModels[3].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Background="#1a5a1a"/>

                <!-- Lane divider lines -->
                <Line Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                      X1="50" Y1="51" X2="5000" Y2="51" Stroke="#44FFFFFF" StrokeThickness="1"
                      Visibility="{Binding SeatViewModels[0].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Line Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      X1="50" Y1="51" X2="5000" Y2="51" Stroke="#44FFFFFF" StrokeThickness="1"
                      Visibility="{Binding SeatViewModels[1].IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                <Line Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                      X1="50" Y1="51" X2="5000" Y2="51" Stroke="#44FFFFFF" StrokeThickness="1"
                      Visibility="{Binding SeatViewModels[2].IsJoined, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Lane labels (left side) — P1 highlighted as active -->
                <Border Grid.Row="0" Grid.Column="0" Background="#22000000"
                        Visibility="{Binding SeatViewModels[0].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="P1" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#22000000"
                        Visibility="{Binding SeatViewModels[1].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#4488FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="P2" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Background="#22000000"
                        Visibility="{Binding SeatViewModels[2].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#44DD44" HorizontalAlignment="Center"/>
                        <TextBlock Text="P3" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="0" Background="#22000000"
                        Visibility="{Binding SeatViewModels[3].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FFDD44" HorizontalAlignment="Center"/>
                        <TextBlock Text="P4" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Finish column (right side, checkered) -->
                <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2">
                    <Grid>
                        <Border Background="#DDFFFFFF" Width="6" HorizontalAlignment="Left"/>
                        <Border Background="#88000000" Width="6" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                        <Border Background="#DDFFFFFF" Width="6" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                        <TextBlock Text="F&#x0A;I&#x0A;N&#x0A;I&#x0A;S&#x0A;H" Foreground="White"
                                   FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,2,0"
                                   TextAlignment="Center" LineHeight="13"/>
                    </Grid>
                </Border>

                <!-- ═══ HORSE 1 (Red) ═══ -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,4"
                      Visibility="{Binding SeatViewModels[0].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <!-- Trail line -->
                    <Border Background="#44FF4444" Height="4" VerticalAlignment="Center"
                            HorizontalAlignment="Left" CornerRadius="2"
                            Width="{Binding SeatViewModels[0].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000|width}"/>
                    <!-- Horse jockey -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{Binding SeatViewModels[0].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000}">
                        <Border CornerRadius="8,16,16,8" Width="54" Height="38"
                                BorderBrush="#FFEEEE" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                    <GradientStop Color="#EE3333" Offset="0"/>
                                    <GradientStop Color="#BB1111" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Symbol mode -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding UseSymbolIcon, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#x265E;" Foreground="White" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="1" Foreground="White" FontWeight="Black"
                                               FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Image mode -->
                                <Image Source="/Assets/horse-racing.png" Height="32" Stretch="Uniform"
                                       Visibility="{Binding UseImageIcon, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- ═══ HORSE 2 (Blue) ═══ -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4"
                      Visibility="{Binding SeatViewModels[1].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#444488FF" Height="4" VerticalAlignment="Center"
                            HorizontalAlignment="Left" CornerRadius="2"
                            Width="{Binding SeatViewModels[1].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000|width}"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{Binding SeatViewModels[1].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000}">
                        <Border CornerRadius="8,16,16,8" Width="54" Height="38"
                                BorderBrush="#EEEEFF" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                    <GradientStop Color="#3366EE" Offset="0"/>
                                    <GradientStop Color="#1144BB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding UseSymbolIcon, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#x265E;" Foreground="White" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="2" Foreground="White" FontWeight="Black"
                                               FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Image Source="/Assets/horse-racing.png" Height="32" Stretch="Uniform"
                                       Visibility="{Binding UseImageIcon, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- ═══ HORSE 3 (Green) ═══ -->
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,4"
                      Visibility="{Binding SeatViewModels[2].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#4444DD44" Height="4" VerticalAlignment="Center"
                            HorizontalAlignment="Left" CornerRadius="2"
                            Width="{Binding SeatViewModels[2].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000|width}"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{Binding SeatViewModels[2].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000}">
                        <Border CornerRadius="8,16,16,8" Width="54" Height="38"
                                BorderBrush="#EEFFEE" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                    <GradientStop Color="#33BB33" Offset="0"/>
                                    <GradientStop Color="#118811" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding UseSymbolIcon, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#x265E;" Foreground="White" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="3" Foreground="White" FontWeight="Black"
                                               FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Image Source="/Assets/horse-racing.png" Height="32" Stretch="Uniform"
                                       Visibility="{Binding UseImageIcon, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- ═══ HORSE 4 (Yellow) ═══ -->
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4"
                      Visibility="{Binding SeatViewModels[3].IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#44DDAA22" Height="4" VerticalAlignment="Center"
                            HorizontalAlignment="Left" CornerRadius="2"
                            Width="{Binding SeatViewModels[3].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000|width}"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{Binding SeatViewModels[3].TotalScore, Converter={StaticResource ScoreToMargin}, ConverterParameter=150000}">
                        <Border CornerRadius="8,16,16,8" Width="54" Height="38"
                                BorderBrush="#FFFFEE" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                    <GradientStop Color="#DDAA22" Offset="0"/>
                                    <GradientStop Color="#AA7700" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding UseSymbolIcon, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#x265E;" Foreground="White" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="4" Foreground="White" FontWeight="Black"
                                               FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Image Source="/Assets/horse-racing.png" Height="32" Stretch="Uniform"
                                       Visibility="{Binding UseImageIcon, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- Score markers row (bottom of track) -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid Margin="50,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="6K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="12K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="18K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="24K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="30K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="36K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="42K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="48K" Foreground="#CCFFFFFF" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════
             ROW 2 — POINT CHART (horizontal 5-col × 2-row)
             ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0c0c22" BorderBrush="#222244" BorderThickness="1"
                Margin="4,0,4,0" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: High Card, 2 Pair, Straight, Full House, Str.Flush -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#222244" BorderThickness="0,0,1,1"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="High Card" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Face Value" Foreground="#889999"
                                   FontSize="10" FontStyle="Italic" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#222244" BorderThickness="0,0,1,1"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="2 Pair" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="6,700" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#222244" BorderThickness="0,0,1,1"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Straight" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="12,000" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" BorderBrush="#222244" BorderThickness="0,0,1,1"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Full House" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="18,700" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" BorderBrush="#222244" BorderThickness="0,0,0,1"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Str. Flush" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="28,500" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Row 2: Any Pair, 3 of a Kind, Flush, 4 of a Kind, Royal Flush -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#222244" BorderThickness="0,0,1,0"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Any Pair" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="4,500" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#222244" BorderThickness="0,0,1,0"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="3 Of A Kind" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="9,000" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#222244" BorderThickness="0,0,1,0"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Flush" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="15,000" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" BorderBrush="#222244" BorderThickness="0,0,1,0"
                        Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="4 Of A Kind" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="22,500" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="4" Padding="6,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Royal Flush" Foreground="{StaticResource GoldAccent}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="37,500" Foreground="White"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════
             ROW 3+4 — CARD AREA: Selection Row + Hand Row (seat 0)
             Click a selection card to add it to your hand.
             A new random card replaces it in the selection row.
             ════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Grid.RowSpan="3" Background="#0e0e1c" Margin="4,2,4,0" Padding="4,4"
                Visibility="{Binding IsInGame, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top info bar: Player badge | Hand result | Round badge -->
                <Grid Grid.Row="0" Margin="4,2,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active player badge (left) -->
                    <Border Grid.Column="0" CornerRadius="6" Padding="10,4"
                            Background="{Binding ActiveSeat.SeatColorBrush}"
                            BorderBrush="{Binding ActiveSeat.SeatColorBrush}" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x265E;" Foreground="White" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="{Binding UseSymbolIcon, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Source="/Assets/horse-racing.png" Height="20" Stretch="Uniform"
                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                   Visibility="{Binding UseImageIcon, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding ActiveSeat.SeatLabel}"
                                       Foreground="White" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hand result name (center) with optional animated border -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="6" ClipToBounds="True" Height="34" MaxWidth="400">
                        <Grid>
                            <Image gif:ImageBehavior.AnimatedSource="/Assets/Animated-Border-Marquee.gif"
                                   Stretch="Fill" Opacity="0.85"
                                   Visibility="{Binding UseHandResultMarquee, Converter={StaticResource BoolToVisibility}}"/>
                            <Image gif:ImageBehavior.AnimatedSource="/Assets/flashing_lights.gif"
                                   Stretch="Fill" Opacity="0.85"
                                   Visibility="{Binding UseHandResultLights, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding ActiveSeat.HandName}"
                                       Foreground="{StaticResource GoldAccent}" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="20,0"/>
                        </Grid>
                    </Border>

                    <!-- Round badge (right) -->
                    <Border Grid.Column="2" Background="#AA22CC" BorderBrush="#DDC800"
                            BorderThickness="2" CornerRadius="4" Padding="12,4"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Round" Foreground="#FFD700" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RoundNumberDisplay}" Foreground="#FFD700"
                                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HAND ROW: 5 slots that fill up as you pick (pinned to top, scales with window) -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both"
                         MaxHeight="140" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hand" Foreground="#445566" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding ActiveSeat.Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Border Width="72" Height="100" CornerRadius="5"
                                                BorderBrush="#556688" BorderThickness="1.5"
                                                Background="White"
                                                Visibility="{Binding Card, Converter={StaticResource BoolToVisibility}}">
                                            <Image Source="{Binding Card, Converter={StaticResource CardToImage}}"
                                                   Stretch="Uniform" Margin="2"/>
                                        </Border>
                                        <Border Width="72" Height="100" CornerRadius="5"
                                                BorderBrush="#222244" BorderThickness="1.5"
                                                Background="#0a0a1a"
                                                Visibility="{Binding Card, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <TextBlock Text="?" Foreground="#222244" FontSize="24"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Hand" Foreground="#445566" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Viewbox>

                <!-- SELECTION ROW: 5 face-up cards to pick from (scales to fill remaining space) -->
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                         MaxHeight="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pick" Foreground="#668899" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding ActiveSeat.ShowSelectionCards, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding ActiveSeat.SelectionCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ToggleHoldCommand}"
                                            IsEnabled="{Binding CanToggle}"
                                            Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Padding="0" Margin="4,0">
                                        <Grid>
                                            <Border Width="100" Height="140" CornerRadius="6"
                                                    BorderBrush="#556688" BorderThickness="1.5"
                                                    Background="White">
                                                <Image Source="{Binding Card, Converter={StaticResource CardToImage}}"
                                                       Stretch="Uniform" Margin="3"/>
                                            </Border>
                                            <Border Width="100" Height="140" CornerRadius="6"
                                                    BorderThickness="2" Opacity="0.5"
                                                    Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="#00DDDD"/>
                                                </Border.BorderBrush>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Pick" Foreground="#668899" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding ActiveSeat.ShowSelectionCards, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Viewbox>

                <!-- Continue button (only when auto-advance is disabled) -->
                <Button Grid.Row="2" Style="{StaticResource ActionBtn}" Content="CONTINUE"
                        Command="{Binding ActiveSeat.ContinueCommand}"
                        Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" Margin="0,4,0,4" FontSize="14" Padding="20,6"/>
            </Grid>
            </Grid>
        </Border>

        <!-- ════ GAME OVER OVERLAY ════ -->
        <Border Grid.RowSpan="6" Background="#DD000010"
                Visibility="{Binding Phase, Converter={StaticResource PhaseToVisibility}, ConverterParameter=GameOver}">
            <Border Background="#CC080818" CornerRadius="12" Padding="40,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GAME OVER" Foreground="{StaticResource GoldAccent}"
                               FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="#667788" FontSize="14" HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        <Run Text="Press ESC or click to return"/>
                    </TextBlock>
                    <Button Style="{StaticResource ActionBtn}" Content="RETURN TO MENU"
                            Command="{Binding ExitGameCommand}" Margin="0,16,0,0"
                            FontSize="16" Padding="24,10"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
