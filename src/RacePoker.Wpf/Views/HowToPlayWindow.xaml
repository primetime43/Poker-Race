<Window x:Class="RacePoker.Wpf.Views.HowToPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to Play"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="10" BorderBrush="#2a2a55" BorderThickness="2"
            Background="#0c0c22">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="HOW TO PLAY" FontSize="20" FontWeight="Bold"
                       Foreground="#00d4d4" HorizontalAlignment="Center"
                       Margin="0,0,0,16" FontFamily="Consolas"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>

                    <!-- Goal -->
                    <TextBlock Text="GOAL" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                        Build strong poker hands to move your horse along the track.
                        <Run Text="{Binding FinishRuleDisplay}"/>
                        <LineBreak/><Run Text="{Binding RaceRulesDisplay}"/>
                    </TextBlock>

                    <!-- How It Works -->
                    <TextBlock Text="HOW IT WORKS" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4">
                        1. Choose the number of players (1-4) from the main menu.
                    </TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4">
                        2. Each round, players take turns picking cards. You are shown 5 face-up
                        selection cards. Pick one to add it to your hand.
                    </TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4">
                        3. After picking, the selection card is replaced with a new card
                        from the deck. Continue until your 5-card hand is complete.
                    </TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4">
                        4. Your hand is scored based on poker rankings. Better hands earn
                        more points!
                    </TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                        5. Each completed hand adds the points shown in the point chart to your score and moves your horse forward.
                        The same hand earns the same points in every round.
                        Compare every player’s hand in the round summary. Continue manually or use auto-advance.
                    </TextBlock>

                    <!-- Controls -->
                    <TextBlock Text="CONTROLS" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1-5 / F1-F5"
                                   Foreground="#00FF88" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Pick a selection card"
                                   Foreground="#CCDDEE" FontSize="13" Margin="0,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Enter"
                                   Foreground="#00FF88" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Continue to next round"
                                   Foreground="#CCDDEE" FontSize="13" Margin="0,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Space"
                                   Foreground="#00FF88" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Start a one-player race"
                                   Foreground="#CCDDEE" FontSize="13" Margin="0,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ESC"
                                   Foreground="#00FF88" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Exit game / return to menu"
                                   Foreground="#CCDDEE" FontSize="13" Margin="0,2"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Mouse / F11"
                                   Foreground="#00FF88" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Click controls / fullscreen"
                                   Foreground="#CCDDEE" FontSize="13" Margin="0,2"/>
                    </Grid>

                    <!-- Hand Rankings -->
                    <TextBlock Text="HAND RANKINGS" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Royal Flush  -  Best hand</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Straight Flush</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Four of a Kind</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Full House</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Flush</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Straight</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Three of a Kind</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">Two Pair</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas">One Pair</TextBlock>
                    <TextBlock Foreground="#CCDDEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontFamily="Consolas" Text="{Binding HighCardRuleDisplay}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Close button -->
            <Button Grid.Row="2" Style="{StaticResource ActionBtn}" Content="CLOSE"
                    MinWidth="120" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
