<Window x:Class="RacePoker.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Thin rounded scrollbar thumb -->
        <Style x:Key="DarkThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#334466" CornerRadius="3"
                                Margin="0,1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible track repeat button -->
        <Style x:Key="DarkTrackBtn" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark vertical scrollbar (thin, no arrows) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="#14142a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#14142a" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkTrackBtn}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumb}" MinHeight="20"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkTrackBtn}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" BorderBrush="#2a2a55" BorderThickness="2"
            Background="#0c0c22">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock Grid.Row="0" Text="SETTINGS" FontSize="20" FontWeight="Bold"
                       Foreground="#00d4d4" HorizontalAlignment="Center"
                       Margin="0,0,0,16" FontFamily="Consolas"/>

            <!-- Settings controls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,16" Padding="0,0,20,0">
            <StackPanel>

                <!-- ── Gameplay ── -->
                <TextBlock Text="GAMEPLAY" FontSize="14" FontWeight="Bold"
                           Foreground="#00d4d4" Margin="0,0,0,8" FontFamily="Consolas"/>

                <!-- Sound Enabled Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sound Effects"
                               Foreground="#EEEEFF" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding SoundEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Auto-Advance Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Advance Between Rounds"
                               Foreground="#EEEEFF" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Auto-Advance Delay -->
                <TextBlock Text="Auto-Advance Delay (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding AutoAdvanceDelaySeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding AutoAdvanceDelaySeconds, StringFormat={}{0:F1}}"/>
                </Grid>

                <!-- Max Rounds -->
                <TextBlock Text="Max Rounds" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxRounds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding MaxRounds}"/>
                </Grid>

                <!-- Picking Timeout -->
                <TextBlock Text="Picking Timeout (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="5" Maximum="60" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PickingTimeoutSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding PickingTimeoutSeconds, StringFormat={}{0:F0}}"/>
                </Grid>

                <!-- Racing Duration -->
                <TextBlock Text="Racing Duration (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0.5" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding RacingDurationSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RacingDurationSeconds, StringFormat={}{0:F1}}"/>
                </Grid>
                <!-- Race Icon Style -->
                <TextBlock Text="Race Icon" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton IsChecked="{Binding IsSymbolIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x265E;" FontSize="18" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Symbol" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsImageIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/horse-racing.png" Width="24" Height="18"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Image" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Hand Result Style -->
                <TextBlock Text="Hand Result Style" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton IsChecked="{Binding IsHandResultPlain}" Foreground="#EEEEFF"
                                 GroupName="HandResult" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Plain" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsHandResultMarquee}" Foreground="#EEEEFF"
                                 GroupName="HandResult" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Marquee" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsHandResultLights}" Foreground="#EEEEFF"
                                 GroupName="HandResult"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Lights" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>
                <!-- ── Attract Screen ── -->
                <Rectangle Height="1" Fill="#2a2a55" Margin="0,4,0,12"/>
                <TextBlock Text="ATTRACT SCREEN" FontSize="14" FontWeight="Bold"
                           Foreground="#00d4d4" Margin="0,0,0,8" FontFamily="Consolas"/>

                <!-- Card Fan Sway -->
                <TextBlock Text="Card Fan Sway (degrees)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding CardSwayDegrees}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding CardSwayDegrees, StringFormat={}{0:F0}°}"/>
                </Grid>

                <!-- Logo Glow -->
                <TextBlock Text="Logo Glow Size" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="50" TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding LogoGlowBlur}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding LogoGlowBlur, StringFormat={}{0:F0}}"/>
                </Grid>
            </StackPanel>
            </ScrollViewer>

            <!-- OK / Cancel buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource ActionBtn}" Content="OK"
                        MinWidth="100" Margin="0,0,12,0"
                        Click="OkButton_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Cancel"
                        MinWidth="100"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
