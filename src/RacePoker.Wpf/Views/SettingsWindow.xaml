<Window x:Class="RacePoker.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="10" BorderBrush="#2a2a55" BorderThickness="2"
            Background="#0c0c22">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock Grid.Row="0" Text="SETTINGS" FontSize="20" FontWeight="Bold"
                       Foreground="#00d4d4" HorizontalAlignment="Center"
                       Margin="0,0,0,16" FontFamily="Consolas"/>

            <!-- Settings controls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- Auto-Advance Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Advance Between Rounds"
                               Foreground="#EEEEFF" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Auto-Advance Delay -->
                <TextBlock Text="Auto-Advance Delay (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding AutoAdvanceDelaySeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding AutoAdvanceDelaySeconds, StringFormat={}{0:F1}}"/>
                </Grid>

                <!-- Max Rounds -->
                <TextBlock Text="Max Rounds" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxRounds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding MaxRounds}"/>
                </Grid>

                <!-- Picking Timeout -->
                <TextBlock Text="Picking Timeout (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="5" Maximum="60" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PickingTimeoutSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding PickingTimeoutSeconds, StringFormat={}{0:F0}}"/>
                </Grid>

                <!-- Racing Duration -->
                <TextBlock Text="Racing Duration (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0.5" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding RacingDurationSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RacingDurationSeconds, StringFormat={}{0:F1}}"/>
                </Grid>
                <!-- Race Icon Style -->
                <TextBlock Text="Race Icon" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton IsChecked="{Binding IsSymbolIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x265E;" FontSize="18" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Symbol" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsImageIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/horse-racing.png" Width="24" Height="18"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Image" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- OK / Cancel buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource ActionBtn}" Content="OK"
                        MinWidth="100" Margin="0,0,12,0"
                        Click="OkButton_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Cancel"
                        MinWidth="100"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
