<Window x:Class="RacePoker.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Track x:Name="PART_Track" Height="44" Margin="14,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="6" Background="#72E6C2" CornerRadius="3"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Width="28" Height="36"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#72E6C2" BorderBrush="#D8FFF2" BorderThickness="1" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="6" Background="#345261" CornerRadius="3"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="28" Height="28" CornerRadius="5" Background="#14333C" BorderBrush="#72E6C2" BorderThickness="2">
                        <Path x:Name="Tick" Data="M 5,13 L 11,20 L 23,6" Stroke="#72E6C2" StrokeThickness="3" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F4CF75"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton"><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15"/></Style>

        <!-- Thin rounded scrollbar thumb -->
        <Style x:Key="DarkThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#334466" CornerRadius="3"
                                Margin="0,1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible track repeat button -->
        <Style x:Key="DarkTrackBtn" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark vertical scrollbar (thin, no arrows) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Background" Value="#14142a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#14142a" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkTrackBtn}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumb}" MinHeight="40"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkTrackBtn}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" BorderBrush="#2a2a55" BorderThickness="2"
            Background="#0c0c22">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock Grid.Row="0" Text="SETTINGS" FontSize="20" FontWeight="Bold"
                       Foreground="#00d4d4" HorizontalAlignment="Center"
                       Margin="0,0,0,16" FontFamily="Consolas"/>

            <!-- Settings controls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,16" Padding="0,0,20,0" PanningMode="VerticalOnly">
            <StackPanel>

                <!-- ── Gameplay ── -->
                <TextBlock Text="GAMEPLAY" FontSize="14" FontWeight="Bold"
                           Foreground="#00d4d4" Margin="0,0,0,8" FontFamily="Consolas"/>

                <!-- Sound Enabled Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sound Effects"
                               Foreground="#EEEEFF" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding SoundEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Race rules can be edited from the menu between games." Foreground="#A9C7D8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel IsEnabled="{Binding RulesEditable}">
                <!-- Auto-Advance Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Advance Between Rounds"
                               Foreground="#EEEEFF" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Auto-Advance Delay -->
                <TextBlock Text="Auto-Advance Delay (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding AutoAdvanceDelaySeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding AutoAdvanceDelaySeconds, StringFormat={}{0:F1}}"/>
                </Grid>

                <!-- Max Rounds -->
                <TextBlock Text="Max Rounds" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxRounds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding MaxRounds}"/>
                </Grid>

                <TextBlock Text="Finish Distance (points)" Foreground="#A9C7D8" FontSize="14" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <Button Content="−" Command="{Binding DecreaseDistanceCommand}" Style="{StaticResource ActionBtn}" FontSize="24" MinWidth="0" MinHeight="48" Padding="4" AutomationProperties.Name="Decrease finish distance by 1000"/>
                    <TextBox x:Name="FinishDistanceInput" Grid.Column="1" Text="{Binding FinishDistanceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" FontSize="22" Padding="10" TextAlignment="Center" Margin="8,0" MinHeight="48" Background="#08151F" Foreground="#72E6C2" AutomationProperties.Name="Finish distance in points"/>
                    <Button Grid.Column="2" Content="+" Command="{Binding IncreaseDistanceCommand}" Style="{StaticResource ActionBtn}" FontSize="24" MinWidth="0" MinHeight="48" Padding="4" AutomationProperties.Name="Increase finish distance by 1000"/>
                </Grid>
                <TextBlock Text="{Binding FinishDistanceError}" Foreground="#F78575" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <CheckBox Content="First horse to finish ends the race" IsChecked="{Binding FirstToFinish}" Foreground="#EEEEFF" Margin="0,0,0,6"/>
                <TextBlock Text="Off: everyone completes the round; highest total wins. On: remaining turns are skipped after a horse finishes." Foreground="#A9C7D8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <CheckBox Content="High card: sum all five ranks" IsChecked="{Binding SumHighCards}" Foreground="#EEEEFF" Margin="0,0,0,6"/>
                <TextBlock Text="Off: highest rank only. J=11, Q=12, K=13, A=14. The original cabinet's Face Value formula and finish timing are unverified." Foreground="#A9C7D8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <CheckBox Content="Untimed card picking" IsChecked="{Binding UntimedPicking}" Foreground="#EEEEFF" Margin="0,0,0,12"/>
                <!-- Picking Timeout -->
                <TextBlock Text="Picking Timeout (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding UntimedPicking}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="5" Maximum="60" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PickingTimeoutSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding PickingTimeoutSeconds, StringFormat={}{0:F0}}"/>
                </Grid>

                <!-- Racing Duration -->
                <TextBlock Text="Racing Duration (seconds)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0.5" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding RacingDurationSeconds}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RacingDurationSeconds, StringFormat={}{0:F1}}"/>
                </Grid>
                </StackPanel>
                <!-- Race Icon Style -->
                <TextBlock Text="Race Icon" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton IsChecked="{Binding IsSymbolIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x265E;" FontSize="18" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Symbol" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsImageIcon}" Foreground="#EEEEFF"
                                 GroupName="RaceIcon"
                                 VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/horse-racing.png" Width="24" Height="18"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Animated horse" FontSize="13" Foreground="#EEEEFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Hand Result Style -->
                <TextBlock Text="Hand Result Style" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton IsChecked="{Binding IsHandResultPlain}" Foreground="#EEEEFF"
                                 GroupName="HandResult" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Plain" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsHandResultMarquee}" Foreground="#EEEEFF"
                                 GroupName="HandResult" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Marquee" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsHandResultLights}" Foreground="#EEEEFF"
                                 GroupName="HandResult"
                                 VerticalContentAlignment="Center">
                        <TextBlock Text="Lights" FontSize="13" Foreground="#EEEEFF"
                                   VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>
                <!-- ── Attract Screen ── -->
                <Rectangle Height="1" Fill="#2a2a55" Margin="0,4,0,12"/>
                <TextBlock Text="ATTRACT SCREEN" FontSize="14" FontWeight="Bold"
                           Foreground="#00d4d4" Margin="0,0,0,8" FontFamily="Consolas"/>

                <!-- Card Fan Sway -->
                <TextBlock Text="Card Fan Sway (degrees)" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding CardSwayDegrees}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding CardSwayDegrees, StringFormat={}{0:F0}°}"/>
                </Grid>

                <!-- Logo Glow -->
                <TextBlock Text="Logo Glow Size" Foreground="#668899"
                           FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="50" TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding LogoGlowBlur}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#00FF88" FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding LogoGlowBlur, StringFormat={}{0:F0}}"/>
                </Grid>
            </StackPanel>
            </ScrollViewer>

            <!-- OK / Cancel buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource ActionBtn}" Content="OK"
                        MinWidth="140" MinHeight="48" Margin="0,0,12,0"
                        Click="OkButton_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Cancel"
                        MinWidth="140" MinHeight="48"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
