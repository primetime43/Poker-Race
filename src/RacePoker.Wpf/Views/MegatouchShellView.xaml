<UserControl x:Class="RacePoker.Wpf.Views.MegatouchShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1280">

    <!-- ══════════════════════════════════════════════════════════
         MEGATOUCH CABINET SHELL
         Center: Attract screen  |  Right: Player buttons
         ══════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource ShellRadialBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="186"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════
             CENTER: Race Poker Attract Screen
             ════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main attract content: Logo (left) + High Scores (right) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RACE POKER Logo Area -->
                <Border Grid.Column="0" Margin="0,6,8,6">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <!-- Card fan decoration -->
                        <Grid Width="80" Height="60" Margin="0,0,0,8">
                            <Border Width="40" Height="56" CornerRadius="4"
                                    Background="#1a3565" BorderBrush="#446688" BorderThickness="1"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-15"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="40" Height="56" CornerRadius="4"
                                    Background="#1a3565" BorderBrush="#446688" BorderThickness="1"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="40" Height="56" CornerRadius="4"
                                    Background="#1a3565" BorderBrush="#446688" BorderThickness="1"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="15"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- RACE POKER text -->
                        <Border Background="#CC2222" CornerRadius="4" Padding="8,4" Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="RACE" FontSize="22" FontWeight="Black"
                                           Foreground="#FFD700" HorizontalAlignment="Center"
                                           FontFamily="Impact"/>
                                <TextBlock Text="POKER" FontSize="18" FontWeight="Black"
                                           Foreground="White" HorizontalAlignment="Center"
                                           FontFamily="Impact" Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Credits display -->
                        <TextBlock Foreground="#556677" FontSize="11" Margin="0,20,0,0"
                                   HorizontalAlignment="Center">
                            <Run Text="0" Foreground="#889999"/> <Run Text="CREDITS"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- HIGH SCORE TABLE -->
                <Border Grid.Column="1" Style="{StaticResource HSPanel}" Margin="0,6,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Score list -->
                        <ItemsControl ItemsSource="{Binding HighScores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Initials -->
                                        <TextBlock Grid.Column="0" Text="{Binding Initials}"
                                                   Foreground="#AABBCC" FontSize="13"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <!-- Score -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Score, StringFormat=N0}"
                                                   Foreground="White" FontSize="14"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <!-- Date -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Date, StringFormat=MM/dd/yy}"
                                                   Foreground="#667788" FontSize="12"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <!-- Dotted separator line at bottom -->
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="No scores yet" Foreground="#334455" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighScores.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- "Press Player Button to Start" pill bar -->
            <Border Grid.Row="1" Style="{StaticResource PillBar}" Margin="4,4,4,4">
                <Grid>
                    <TextBlock Text="Press Player Button to Start"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.3" Duration="0:0:1.2"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <!-- Help ? button at right end of pill bar -->
                    <Button Style="{StaticResource HelpBtn}" Content="?"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0"/>
                </Grid>
            </Border>

            <!-- Bottom credits line -->
            <TextBlock Grid.Row="2" Foreground="#445566" FontSize="10"
                       Margin="4,4,4,2">
                <Run Text="0 CREDITS"/>
            </TextBlock>
        </Grid>

        <!-- ════════════════════════════════════════════════
             RIGHT COLUMN: megatouch branding + Player Buttons
             ════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="#0a0a14" BorderBrush="#1a1a33"
                BorderThickness="1,0,0,0" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- megatouch branding -->
                <TextBlock Grid.Row="0" Text="megatouch"
                           FontSize="16" FontWeight="Bold" FontStyle="Italic"
                           Foreground="#88AABB" HorizontalAlignment="Center"
                           Margin="0,8,0,10"/>

                <!-- 4 Player Buttons -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">

                    <!-- Player 1 Button -->
                    <Button Style="{StaticResource PlayerBtn}"
                            Command="{Binding PlayerJoinCommand}" CommandParameter="0">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Single person silhouette -->
                            <Grid Height="36" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="36">
                                        <Ellipse Canvas.Left="5" Canvas.Top="0"
                                                 Width="14" Height="14" Fill="#CCEEEE"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="16"
                                                   Width="18" Height="18"
                                                   RadiusX="4" RadiusY="4" Fill="#CCEEEE"/>
                                    </Canvas>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Button>

                    <!-- Player 2 Button -->
                    <Button Style="{StaticResource PlayerBtn}"
                            Command="{Binding PlayerJoinCommand}" CommandParameter="1">
                        <Grid Height="36" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="36">
                                    <Ellipse Canvas.Left="5" Canvas.Top="2"
                                             Width="13" Height="13" Fill="#CCEEEE"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="17"
                                               Width="17" Height="17"
                                               RadiusX="4" RadiusY="4" Fill="#CCEEEE"/>
                                </Canvas>
                                <Canvas Width="24" Height="36" Margin="-6,0,0,0">
                                    <Ellipse Canvas.Left="5" Canvas.Top="2"
                                             Width="13" Height="13" Fill="#AADDDD"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="17"
                                               Width="17" Height="17"
                                               RadiusX="4" RadiusY="4" Fill="#AADDDD"/>
                                </Canvas>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Player 3 Button -->
                    <Button Style="{StaticResource PlayerBtn}"
                            Command="{Binding PlayerJoinCommand}" CommandParameter="2">
                        <Grid Height="36" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Canvas Width="22" Height="36">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="12" Height="12" Fill="#CCEEEE"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="16"
                                               Width="16" Height="16"
                                               RadiusX="3" RadiusY="3" Fill="#CCEEEE"/>
                                </Canvas>
                                <Canvas Width="22" Height="36" Margin="-4,0,0,0">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="12" Height="12" Fill="#AADDDD"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="16"
                                               Width="16" Height="16"
                                               RadiusX="3" RadiusY="3" Fill="#AADDDD"/>
                                </Canvas>
                                <Canvas Width="22" Height="36" Margin="-4,0,0,0">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="12" Height="12" Fill="#88CCCC"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="16"
                                               Width="16" Height="16"
                                               RadiusX="3" RadiusY="3" Fill="#88CCCC"/>
                                </Canvas>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Player 4 Button -->
                    <Button Style="{StaticResource PlayerBtn}"
                            Command="{Binding PlayerJoinCommand}" CommandParameter="3">
                        <Grid Height="36" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Canvas Width="20" Height="34">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="11" Height="11" Fill="#CCEEEE"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15"
                                               Width="15" Height="15"
                                               RadiusX="3" RadiusY="3" Fill="#CCEEEE"/>
                                </Canvas>
                                <Canvas Width="20" Height="34" Margin="-3,0,0,0">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="11" Height="11" Fill="#AADDDD"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15"
                                               Width="15" Height="15"
                                               RadiusX="3" RadiusY="3" Fill="#AADDDD"/>
                                </Canvas>
                                <Canvas Width="20" Height="34" Margin="-3,0,0,0">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="11" Height="11" Fill="#88CCCC"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15"
                                               Width="15" Height="15"
                                               RadiusX="3" RadiusY="3" Fill="#88CCCC"/>
                                </Canvas>
                                <Canvas Width="20" Height="34" Margin="-3,0,0,0">
                                    <Ellipse Canvas.Left="4" Canvas.Top="2"
                                             Width="11" Height="11" Fill="#66AABB"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15"
                                               Width="15" Height="15"
                                               RadiusX="3" RadiusY="3" Fill="#66AABB"/>
                                </Canvas>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- M brand button at bottom -->
                <Button Grid.Row="2" Style="{StaticResource BrandBtn}"
                        Content="M" HorizontalAlignment="Center" Margin="0,8,0,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
