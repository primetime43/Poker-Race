<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RacePoker.Wpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\kpoker.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RacePoker.Core\RacePoker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PokerCards\*.png" />
    <Resource Include="Assets\kpoker.ico" />
    <Resource Include="Assets\horse-racing.png" />
    <EmbeddedResource Include="Config\pointTable.json" LogicalName="RacePoker.PointTable.json" />
  </ItemGroup>

</Project>
