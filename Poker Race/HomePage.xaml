<Page x:Class="Poker_Race.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      xmlns:local="clr-namespace:Poker_Race"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Viewbox Margin="73,26,88,49">
            <Grid HorizontalAlignment="Center" Height="361" VerticalAlignment="Top" Width="642">
                <Button x:Name="button" Content="Start Game" Margin="255,229,244,10" Click="startGame">
                    <Button.Template>

                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Grid.Background>
                                    <ImageBrush ImageSource="pokerchip.png"></ImageBrush>
                                </Grid.Background>
                            </Grid>

                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Image x:Name="image" gif:ImageBehavior.AnimatedSource="flashing_lights.gif" gif:ImageBehavior.RepeatBehavior="Forever" HorizontalAlignment="Center" Height="201" VerticalAlignment="Center"  Width="560" Margin="46,10,36,150" Stretch="Fill" />
                <TextBlock 
                        x:Name="textBlock" TextAlignment="Center" HorizontalAlignment="Left" Height="60" Margin="46,37,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="560" FontSize="40" FontFamily="Elephant" Foreground="Gold">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="8" Direction="330" Color="Black" Opacity="0.6" BlurRadius="4"/>
                    </TextBlock.Effect><Run Text="Welcome To Poker Race!"/></TextBlock>
                <TextBox x:Name="usernameTextBox" TextAlignment="Center" Text="Enter Your Name" HorizontalAlignment="Left" Height="39" Margin="221,129,0,193" TextWrapping="Wrap"  Width="204" GotFocus="UsernameTextBox_GotFocus" LostFocus="UsernameTextBox_LostFocus" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

            </Grid>
        </Viewbox>

    </Grid>
</Page>
