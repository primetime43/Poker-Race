<Page x:Class="Poker_Race.GameMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Poker_Race"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="GameMainPage">

    <Page.Resources>
        <local:MarginConverter x:Key="marginConverter"/>

        <!-- Horizontal timer bar style (rotated to appear vertical) -->
        <Style x:Key="CountDownProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border BorderBrush="#BBC6C4" BorderThickness="1" CornerRadius="5" Padding="1" Background="Black">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="5" RadiusY="5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                            <GradientStop Color="Red" Offset="0.0"/>
                                            <GradientStop Color="Orange" Offset="0.25"/>
                                            <GradientStop Color="Yellow" Offset="0.50"/>
                                            <GradientStop Color="LimeGreen" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Race Track with Horse (horse moves left to right) -->
        <Style x:Key="RaceTrackStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Race_Track">
                            <Image Source="horse-racing.png" Height="72"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="{Binding ElementName=userProgressBar, Mode=OneWay, Path=Value, Converter={StaticResource marginConverter}}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Draw Card Border with hover effect -->
        <Style x:Key="DrawCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2a2a4a"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF"/>
                    <Setter Property="Background" Value="#3a3a5a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ TOP BAR: Score + Round ═══════ -->
        <Border Grid.Row="0" Background="#12122a" BorderBrush="#FFD700" BorderThickness="0,0,0,2">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Score: " Foreground="#FFD700" FontSize="22" FontWeight="Bold"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Label x:Name="scoreLabel" Content="0" Foreground="#FFD700" FontSize="22"
                           FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" Padding="0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#8B008B" CornerRadius="4" Padding="12,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="textBlockRound" Text="Round 1" Foreground="#FFD700"
                               FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════ TOP HALF: Race Track ═══════ -->
        <Grid Grid.Row="1" Margin="6,6,6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical Timer (far left alongside track) -->
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="timerBar" Grid.Row="0"
                             Style="{StaticResource CountDownProgressBarStyle}"
                             Maximum="30" Minimum="0" Height="28"
                             HorizontalAlignment="Center">
                    <ProgressBar.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </ProgressBar.LayoutTransform>
                </ProgressBar>
                <TextBlock Grid.Row="1" Text="&#x23F1;" FontSize="18"
                           HorizontalAlignment="Center" Foreground="#FFD700" Margin="0,2,0,0"/>
            </Grid>

            <!-- Race Track Field -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Green field with yard lines and horse -->
                <Border Grid.Row="0" Background="#3da63d" BorderBrush="#2a7a2a"
                        BorderThickness="2" CornerRadius="4" Padding="4">
                    <Grid>
                        <!-- Vertical yard-line pattern (white dashes like a football field) -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <VisualBrush TileMode="Tile" Viewport="0,0,0.04,1"
                                             ViewportUnits="RelativeToBoundingBox">
                                    <VisualBrush.Visual>
                                        <Grid Width="10" Height="200">
                                            <Rectangle Width="1" Height="200" Fill="White"
                                                       Opacity="0.4" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Horse progress bar (horizontal, left to right) -->
                        <ProgressBar x:Name="userProgressBar"
                                     Style="{StaticResource RaceTrackStyle}"
                                     Maximum="40000" Minimum="0" Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Score markers below the track -->
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="0" HorizontalAlignment="Left" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker1" Grid.Column="1" Text="5000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker2" Grid.Column="2" Text="10000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker3" Grid.Column="3" Text="15000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker4" Grid.Column="4" Text="20000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker5" Grid.Column="5" Text="25000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker6" Grid.Column="6" Text="30000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker7" Grid.Column="7" Text="35000" HorizontalAlignment="Center" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="scoreMarker8" Grid.Column="8" Text="40000" HorizontalAlignment="Right" Foreground="#FF4444" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════ BOTTOM HALF: Point Chart + Cards ═══════ -->
        <Grid Grid.Row="2" Margin="6,2,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- POINT CHART (horizontal band) -->
            <Border Grid.Row="0" Background="#12122a" BorderBrush="#FFD700"
                    BorderThickness="2" CornerRadius="6" Padding="8" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="POINT CHART" Foreground="#FFD700"
                               FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="2">
                            <TextBlock Text="High Card" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Face Value" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="2">
                            <TextBlock Text="Any Pair" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="4,500" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="2">
                            <TextBlock Text="2 Pair" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="6,700" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Grid.Row="0" Margin="2">
                            <TextBlock Text="3 of a Kind" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="9,000" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Grid.Row="0" Margin="2">
                            <TextBlock Text="Straight" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="12,000" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="2">
                            <TextBlock Text="Flush" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="15,000" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="2">
                            <TextBlock Text="Full House" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="18,700" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="1" Margin="2">
                            <TextBlock Text="4 of a Kind" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="22,500" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Grid.Row="1" Margin="2">
                            <TextBlock Text="Str. Flush" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="28,500" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Grid.Row="1" Margin="2">
                            <TextBlock Text="Royal Flush" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="37,500" Foreground="#ccaa44" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- HAND RESULT (e.g. "2 Pair") — hidden when empty -->
            <TextBlock x:Name="textBlockUserHand" Grid.Row="1" Text="" TextAlignment="Center"
                       Foreground="#C7CF24" FontSize="28" FontWeight="Bold"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,4"/>

            <!-- CARDS AREA: Draw (larger) on left, Hand (smaller) on right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- DRAW pile (left side, larger) -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DRAW" Foreground="#FFD700" FontSize="14"
                               FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <UniformGrid Grid.Row="1" Columns="5">
                        <Border Style="{StaticResource DrawCardStyle}" Margin="2">
                            <Image x:Name="image1" Source="Poker Cards/10_of_clubs.png"
                                   MouseDown="Image1_MouseDown" Cursor="Hand" Stretch="Uniform"/>
                        </Border>
                        <Border Style="{StaticResource DrawCardStyle}" Margin="2">
                            <Image x:Name="image2" Source="Poker Cards/8_of_diamonds.png"
                                   MouseDown="Image2_MouseDown" Cursor="Hand" Stretch="Uniform"/>
                        </Border>
                        <Border Style="{StaticResource DrawCardStyle}" Margin="2">
                            <Image x:Name="image3" Source="Poker Cards/2_of_clubs.png"
                                   MouseDown="Image3_MouseDown" Cursor="Hand" Stretch="Uniform"/>
                        </Border>
                        <Border Style="{StaticResource DrawCardStyle}" Margin="2">
                            <Image x:Name="image4" Source="Poker Cards/8_of_diamonds.png"
                                   MouseDown="Image4_MouseDown" Cursor="Hand" Stretch="Uniform"/>
                        </Border>
                        <Border Style="{StaticResource DrawCardStyle}" Margin="2">
                            <Image x:Name="image5" Source="Poker Cards/10_of_clubs.png"
                                   MouseDown="Image5_MouseDown" Cursor="Hand" Stretch="Uniform"/>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- HAND slots (right side, smaller) -->
                <Grid Grid.Column="1" Margin="4,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="HAND" Foreground="#FFD700" FontSize="14"
                               FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <Border Grid.Row="1" Background="#0d0d20" BorderBrush="#444"
                            BorderThickness="1" CornerRadius="6" Padding="2"
                            MaxHeight="180" VerticalAlignment="Top">
                        <UniformGrid Columns="5">
                            <Border Background="#1a1a3a" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="4" Margin="2" Padding="2" MinHeight="80">
                                <Image x:Name="handCard1" Stretch="Uniform"/>
                            </Border>
                            <Border Background="#1a1a3a" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="4" Margin="2" Padding="2" MinHeight="80">
                                <Image x:Name="handCard2" Stretch="Uniform"/>
                            </Border>
                            <Border Background="#1a1a3a" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="4" Margin="2" Padding="2" MinHeight="80">
                                <Image x:Name="handCard3" Stretch="Uniform"/>
                            </Border>
                            <Border Background="#1a1a3a" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="4" Margin="2" Padding="2" MinHeight="80">
                                <Image x:Name="handCard4" Stretch="Uniform"/>
                            </Border>
                            <Border Background="#1a1a3a" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="4" Margin="2" Padding="2" MinHeight="80">
                                <Image x:Name="handCard5" Stretch="Uniform"/>
                            </Border>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
