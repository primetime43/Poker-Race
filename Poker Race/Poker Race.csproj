<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Poker_Race</RootNamespace>
    <AssemblyName>Poker Race</AssemblyName>
    <ApplicationIcon>kpoker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XamlAnimatedGif" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Poker Cards\*.png" />
    <Resource Include="kpoker.ico" />
    <Resource Include="horse-racing.png" />
    <Resource Include="pokerchip.png" />
    <Content Include="Animated-Border-Marquee.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="flashing_lights.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
